# Discord bot token, from the Bot tab of your application in the Discord Developer Portal.
DISCORD_TOKEN=

# Application ID, from the General Information tab of your application.
CLIENT_ID=

# Optional: a guild (server) ID for instant, guild-scoped slash command registration
# during development. Leave blank to register commands globally instead (can take up
# to an hour to propagate). For a bot that only ever lives in one server, it's fine to
# just leave this set permanently.
GUILD_ID=

# Default playback volume as a percentage (0-200). Used when a fresh queue is created.
DEFAULT_VOLUME=100

# Minutes the bot will stay in a voice channel after every other (non-bot) member has
# left, before automatically disconnecting.
AUTO_DISCONNECT_MINUTES=5

# Whether boot.js should check GitHub for updates (git fetch/pull) before starting the
# bot. Set to "false" to disable (e.g. for local development). Requires the deployment
# to be a real git clone of the repo (not a zip/SFTP upload) with an "origin" remote.
AUTO_UPDATE=true

# Branch to track for boot-time updates.
UPDATE_BRANCH=main
