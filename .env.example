# Discord bot token, from the Bot tab of your application in the Discord Developer Portal.
DISCORD_TOKEN=

# Application ID, from the General Information tab of your application.
CLIENT_ID=

# Optional: a guild (server) ID for instant, guild-scoped slash command registration
# during development. Leave blank to register commands globally instead (can take up
# to an hour to propagate). For a bot that only ever lives in one server, it's fine to
# just leave this set permanently.
GUILD_ID=

# Default playback volume as a percentage (0-200). Used when a fresh queue is created.
DEFAULT_VOLUME=100

# Minutes the bot will stay in a voice channel after every other (non-bot) member has
# left, before automatically disconnecting.
AUTO_DISCONNECT_MINUTES=5

# Whether boot.js should check GitHub for updates (git fetch/pull) before starting the
# bot. Set to "false" to disable (e.g. for local development). Requires the deployment
# to be a real git clone of the repo (not a zip/SFTP upload) with an "origin" remote.
AUTO_UPDATE=true

# Branch to track for boot-time updates.
UPDATE_BRANCH=main

# Whether to (re-)register slash commands with Discord on every boot. Default
# true - there's no separate manual step needed. Set to "false" if you'd
# rather only register via `npm run register-commands` yourself.
REGISTER_COMMANDS_ON_BOOT=true

# Spotify app credentials (Client Credentials flow - no user login involved,
# only used to read public playlist/track metadata). Create an app at
# https://developer.spotify.com/dashboard to get these. Required for
# /jamiematt and for Spotify links via /play; /play still works for direct
# audio/HLS URLs and YouTube links without these set.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# The playlist /jamiematt plays. Defaults to a daily-rotating Spotify
# editorial playlist; swap in any Spotify playlist link.
SPOTIFY_PLAYLIST_URL=https://open.spotify.com/playlist/37i9dQZF1FwL1Q3Lx3jRwp

# How often (in hours) to re-fetch SPOTIFY_PLAYLIST_URL's tracklist and
# re-resolve it against YouTube in the background, in addition to the
# refresh that always happens on boot.
PLAYLIST_REFRESH_HOURS=12

# Optional: yt-dlp --extractor-args, used as a fallback client identity if
# the default one hits YouTube's "Sign in to confirm you're not a bot" check
# (common on datacenter/hosting-provider IPs). Leave unset to use the
# built-in default (youtube:player_client=android) - only set this if that
# stops working and a different client is currently recommended instead. See
# README Troubleshooting.
YTDLP_EXTRACTOR_ARGS=
